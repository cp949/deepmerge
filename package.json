{
  "name": "deepmerge",
  "description": "A library for deep (recursive) merging of Javascript objects",
  "keywords": [
    "merge",
    "deep",
    "extend",
    "copy",
    "clone",
    "recursive"
  ],
  "version": "4.3.1",
  "homepage": "https://github.com/TehShrike/deepmerge",
  "repository": {
    "type": "git",
    "url": "git://github.com/TehShrike/deepmerge.git"
  },
  "main": "dist/cjs.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "npm run build && node --test test/*.js && npm run test:typescript",
    "test:typescript": "tsc -p test/tsconfig.json"
  },
  "devDependencies": {
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
